{
    "name": "backend",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "dev": "nodemon --exec \"node -r tsconfig-paths/register -r ts-node/register src/index.ts\"",
        "start": "node -r tsconfig-paths/register dist/index.js",
        "build": "tsc -p .",
        "lint": "eslint src/**/*.{ts,tsx} --fix",
        "prepare": "husky",
        "format": "prettier --write 'src/**/*.{ts,tsx,json,md,css,yml}'",
        "lint-staged": "lint-staged",
        "seed:rbac": "ts-node -r tsconfig-paths/register scripts/seed-authorization.ts",
        "seed:rbac:clean": "ts-node -r tsconfig-paths/register scripts/seed-authorization.ts --clean"
    },
    "author": "",
    "license": "ISC",
