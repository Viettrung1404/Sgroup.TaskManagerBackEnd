        "@asteasolutions/zod-to-openapi": "^8.1.0",
        "@types/helmet": "^4.0.0",
        "@types/joi": "^17.2.2",
        "bcryptjs": "^3.0.2",
        "cors": "^2.8.5",
        "dotenv": "^17.2.2",
        "envalid": "^8.1.0",
        "express": "^5.1.0",
        "express-rate-limit": "^8.1.0",
        "express-session": "^1.18.2",
        "handlebars": "^4.7.8",
        "helmet": "^8.1.0",
        "http-status-codes": "^2.3.0",
        "joi": "^18.0.1",
        "jsonwebtoken": "^9.0.2",
        "nodemailer": "^7.0.9",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "pg": "^8.16.3",
